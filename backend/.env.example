# Copy to .env. Never commit .env.
# LLM_MODE: mock (default, no API calls), live (needs ANTHROPIC_API_KEY), fail (every model call fails, for testing)
LLM_MODE=mock
ANTHROPIC_API_KEY=
MODEL_ID=claude-haiku-5-5
# Max live model calls per server run, then it switches to mock
LLM_CALL_LIMIT=50
# Allows the /api/dev/llm-mode switch used for demos and evidence
DEV_ENDPOINTS=1
DB_PATH=data/reset.db
